# Continuity Room — environment configuration
# Copy to .env and fill in real values. Never commit .env (already gitignored).
# Every value below is read with no silent default in code that matters for
# correctness — an unset required var fails fast at startup instead of
# quietly pointing at a placeholder.

# ---------------------------------------------------------------------------
# Google Cloud / Gemini (used by the technical producer agent's extraction
# call and by every ADK LlmAgent's underlying model)
# ---------------------------------------------------------------------------
# Set to "true" to call Gemini via Vertex AI (needs GOOGLE_CLOUD_PROJECT +
# application-default credentials). Set to "false" to call the Gemini API
# directly with GOOGLE_API_KEY (simplest for local dev / hackathon demo).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# ClickHouse — write path (technical producer agent, via clickhouse-connect)
# and read path (director agent, via the official ClickHouse MCP server).
# Local dev: point these at the docker-compose ClickHouse (infra/docker).
# Deployed demo: point these at your ClickHouse Cloud instance.
# ---------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=continuity_room
CLICKHOUSE_SECURE=false

# The ClickHouse MCP server (mcp-clickhouse) that the director agent talks
# to is launched as its own subprocess with this flag forced to "false" in
# code (backend/app/agents/director.py) regardless of what's set here — this
# variable exists so the intent is explicit in one place, not to be trusted
# as the sole enforcement.
CLICKHOUSE_ALLOW_WRITE_ACCESS=false

# ---------------------------------------------------------------------------
# Grafana Cloud (studio head agent's dashboard/alert provisioning via the
# official Grafana MCP server, plus infra/grafana provisioning-as-code)
# ---------------------------------------------------------------------------
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# ---------------------------------------------------------------------------
# Alerting — contact point for the severity>=high continuity_flags alert
# ---------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ADDRESS=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Cloud Run / deploy (infra/cloudrun scripts, not read by the app at runtime)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPO=continuity-room
